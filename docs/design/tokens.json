{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "CSA design tokens, decided 2026-09-05. Source of truth with docs/design/palette.md; server/ui/src/style.css defines the same values.",
  "color": {
    "light": {
      "paper": { "$value": "#f8f5ee" }, "card": { "$value": "#fffdf8" }, "line": { "$value": "#e4dfd3" },
      "line-soft": { "$value": "#ece8dd" }, "muted": { "$value": "#726d62" }, "ink": { "$value": "#1b1d22" },
      "accent": { "$value": "#1b1d22" }, "accent-soft": { "$value": "#e9e6de" }, "on-accent": { "$value": "#f8f5ee" },
      "edge": { "$value": "#cfc9bd" }, "n-grey": { "$value": "#d5d0c5" },
      "good": { "$value": "#3f8a55" }, "warn": { "$value": "#9a6d12" }, "bad": { "$value": "#b4433c" }
    },
    "dark": {
      "paper": { "$value": "#1b1a17" }, "card": { "$value": "#23221e" }, "line": { "$value": "#37352f" },
      "line-soft": { "$value": "#2e2c27" }, "muted": { "$value": "#a59e90" }, "ink": { "$value": "#ece7db" },
      "accent": { "$value": "#ece7db" }, "accent-soft": { "$value": "#33312c" }, "on-accent": { "$value": "#1b1a17" },
      "edge": { "$value": "#4a4740" }, "n-grey": { "$value": "#45423b" },
      "good": { "$value": "#7fb98f" }, "warn": { "$value": "#d3a54a" }, "bad": { "$value": "#e0837a" }
    },
    "node": {
      "session": { "$value": "#8f84d8" }, "decision": { "$value": "#5aa46a" }, "gotcha": { "$value": "#ef8a3f" },
      "constraint": { "$value": "#4f8fe6" }, "todo": { "$value": "#e6c235" }, "preference": { "$value": "#e87ba5" },
      "rule": { "$value": "#7f9b8c" }
    }
  },
  "font": {
    "serif": { "$value": "\"Source Serif 4\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif", "weights": [600, 700] },
    "sans": { "$value": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif", "weights": [400, 500, 600] },
    "mono": { "$value": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "base-size": { "$value": "15px" }, "base-line-height": { "$value": 1.5 }
  },
  "shape": {
    "radius-control": { "$value": "10px" }, "radius-card": { "$value": "12px" }, "radius-panel": { "$value": "14px" },
    "nav-height": { "$value": "60px" }, "content-max-width": { "$value": "1240px" }
  },
  "mark": { "ring": { "$value": "circle r=11 stroke 1.8 + filled circle r=6, in the accent; server/ui/public/favicon.svg" } }
}
