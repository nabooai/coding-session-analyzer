{
  "name": "csa-sessions-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sessions feedback UI for coding-session-analyzer (vanilla TS + Vite, no framework).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "check": "tsc --noEmit && eslint src && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
