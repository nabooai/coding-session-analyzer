# Copy to .env beside docker-compose.trial.yml (chmod 600). One value per line, no quotes.
# The 10-minute path is docs/quickstart.md; the on-prem runbook is docs/public-release/install-server.md.

# Required. The URL people type; every installer, sign-in link and Connect one-liner is built from it.
#   on this machine, no proxy:        http://localhost:8766   (then uncomment CSA_MCP_URL below)
#   on-prem with `--profile proxy`:   https://<host>, no port (the proxy listens on 443), no path, no trailing slash
CSA_PUBLIC_URL=https://csa.example.com

# Where laptops reach the MCP server. Defaults to CSA_PUBLIC_URL/mcp, which the proxy routes. Without the proxy:
# CSA_MCP_URL=http://localhost:58768/mcp

# The model. Set ONE API key, or leave both empty and add a provider under Settings > AI Models.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com     # an Anthropic-format gateway, with its key above
# OPENAI_API_KEY=
# OPENAI_MAIN_MODEL=gpt-5
# OPENAI_SMALL_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1              # optional OpenAI-compatible HTTPS endpoint
# CLAUDE_CODE_OAUTH_TOKEN=                                # with-claude-code image only, instead of a key: `claude setup-token`, one person's own use

# For the gateway admin's allowlist: extraction sends claude-sonnet-5; the judge and the router send
# claude-haiku-4-5-20251001 (measured by server/e2e/onprem-egress.sh, the same with and without Claude Code in the
# image). The main model under Settings > AI Models changes the first.

# Everything else (budget, redaction, retention, sign-out, workers) is `csa.py org config` on the server, not this file.

# The server image, when it is not the published one (the offline bundle sets this to the image it loads; Bedrock,
# Vertex and subscription tokens need one you build with `--target with-claude-code`).
# CSA_SERVER_IMAGE=csa-server:local
