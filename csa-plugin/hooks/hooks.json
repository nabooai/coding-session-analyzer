{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.csa/config.json\" ] && [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" ] && python3 -I -S -B \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" recall 2>/dev/null; exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.csa/config.json\" ] && [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" ] && python3 -I -S -B \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" sweep 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.csa/config.json\" ] && [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" ] && python3 -I -S -B \"${CLAUDE_PLUGIN_ROOT}/scripts/csa.py\" ship 2>/dev/null; exit 0"
          }
        ]
      }
    ]
  }
}
